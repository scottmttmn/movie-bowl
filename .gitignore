# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
supabase/.temp/

# Playwright smoke-test artifacts
playwright-report/
test-results/

# Android TV test wrapper
tv-android/.gradle/
tv-android/local.properties
tv-android/**/build/
tv-android/app/release/
tv-android/**/*.jks
tv-android/**/*.keystore
tv-android/captures/
