# Android phone voice-capture probe
android-mobile/.gradle/
android-mobile/local.properties
android-mobile/**/build/
android-mobile/**/release/
android-mobile/captures/
android-mobile/*.iml
android-mobile/**/*.jks
android-mobile/**/*.keystore

# Vitest writes the latest run here so failures can be named after the fact.
.vitest/

# Playwright writes its latest run here so the test counts can be checked.
.playwright/

# pgTAP writes its latest run here for the same reason.
.pgtap/
.env*

# Generated by app-evolution: visual history, regenerable and large. The
# wildcard covers renamed or scratch stores too -- a bare .app-evolution/
# rule once let a moved-aside copy slip into a commit.
.app-evolution*/
