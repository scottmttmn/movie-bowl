{
  "crons": [
    {
      "path": "/api/cron/refresh-filter-metadata",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|@vite/).*)",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/html.*" }
      ],
      "destination": "/index.html"
    }
  ]
}
