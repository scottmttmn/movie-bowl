{
  "crons": [
    {
      "path": "/api/cron/refresh-filter-metadata",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/html.*" }
      ],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/provider-links/lookup",
      "destination": "/api/movie-cache?action=provider-links"
    },
    {
      "source": "/api/tmdb/movie/warm-filter-metadata",
      "destination": "/api/movie-cache?action=warm-filter-metadata"
    },
    {
      "source": "/((?!api/|@vite/).*)",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/html.*" }
      ],
      "destination": "/index.html"
    }
  ]
}
